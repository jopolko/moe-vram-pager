[Unit]
Description=Sliver C2 server (local-only, operator port 31337)
After=network.target

[Service]
Type=simple
User=josh
WorkingDirectory=/home/josh/tools-sliver
ExecStart=/home/josh/tools-sliver/sliver-server daemon --lhost 127.0.0.1 --lport 31337
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
